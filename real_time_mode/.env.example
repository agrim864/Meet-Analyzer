# Optional Hugging Face token for private/cold model downloads.
HF_API_KEY=

# Optional live transcription.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Optional LLM screen summary provider.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_MODEL_FALLBACKS=openai/gpt-oss-120b:free,qwen/qwen3-32b:free,openrouter/free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_FALLBACKS=llama-3.1-8b-instant
FRAME_SUMMARIZER_ENABLED=0
FRAME_SUMMARIZER_PROVIDER=gemini
FRAME_SUMMARIZER_MODEL=gemini-2.5-flash
FRAME_SUMMARIZER_FALLBACK_MODEL=Qwen/Qwen2.5-1.5B-Instruct
FRAME_SUMMARIZER_DEVICE=disabled
FRAME_SUMMARIZER_MAX_NEW_TOKENS=700
FRAME_SUMMARIZER_TEMPERATURE=0.1
FRAME_SUMMARIZER_TIMEOUT_SEC=5.0
FRAME_SUMMARY_MEMORY_SIZE=8

# Local model paths.
SIGLIP_MODEL_NAME=google/siglip2-large-patch16-384
CURSOR_MODEL_PATH=real_time_mode/cursor_class_best.pt
MACRO_LAYOUT_MODEL_REF=real_time_mode/vendor/uitag/yolo-ui.pt
MACRO_LAYOUT_MODEL_FILENAME=yolo-ui.pt
DOCLAYOUT_ENABLED=1
DOCLAYOUT_MODEL_REF=
DOCLAYOUT_REPO_ID=juliozhao/DocLayout-YOLO-DocStructBench
DOCLAYOUT_FILENAME=doclayout_yolo_docstructbench_imgsz1024.pt
DOCLAYOUT_IMGSZ=1024
DOCLAYOUT_CONF=0.20
DOCLAYOUT_IOU=0.45
DOCLAYOUT_DEVICE=auto

# Real-time parser sizing and thresholds.
OCR_MODE=gpu
OCR_BACKEND_GPU=easyocr
OCR_BACKEND_CPU=rapidocr
OCR_LANG=en
SURYA_ENABLED=1
MACRO_LAYOUT_CONF=0.20
MACRO_LAYOUT_IOU=0.45
CHANGE_PIXEL_THRESHOLD=18
CHANGE_PADDING_PX=10
DEMO_CHANGE_TINY_RATIO=0.0010
DEMO_CHANGE_SSIM_THRESHOLD=0.9965
CODE_CHANGE_TINY_RATIO=0.0004
CODE_CHANGE_SSIM_THRESHOLD=0.9985
SLIDE_CHANGE_TINY_RATIO=0.015
SLIDE_CHANGE_SSIM_THRESHOLD=0.9920

# Frontend capture cadence.
VITE_CAPTURE_MAX_SIDE=1920
VITE_FRAME_JPEG_QUALITY=0.58
VITE_MAX_IN_FLIGHT_FRAMES=2
VITE_FULL_FRAME_CHANGE_RATIO=0.55
VITE_SUPERSEDE_IN_FLIGHT_CHANGE_RATIO=0.10
VITE_FRAME_REQUEST_TIMEOUT_MS=120000
VITE_FRAME_INTERVAL_DEMO_MS=300
VITE_FRAME_INTERVAL_CODE_MS=450
VITE_FRAME_INTERVAL_SLIDE_MS=650
VITE_FRAME_INTERVAL_OTHER_MS=1000
VITE_FRAME_INTERVAL_UNKNOWN_MS=500
VITE_MIN_TRANSCRIPT_BLOB_BYTES=2048
VITE_TRANSCRIPT_MAX_CONSECUTIVE_ERRORS=4

# Optional Supabase persistence for live events.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Modal deployment / proxy.
MODAL_API_BASE_URL=
MODAL_PROCESS_FRAME_URL=
MODAL_PROXY_TIMEOUT_SEC=120
ENABLE_LOCAL_MODAL_FALLBACK=0
