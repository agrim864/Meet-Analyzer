# Required for prerecorded transcript generation.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Required for downloading Hugging Face models that are not committed.
HF_API_KEY=

# Optional report writers.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Model paths.
CURSOR_MODEL_PATH=batch_mode/cursor_class_best.pt
MACRO_LAYOUT_MODEL_REF=real_time_mode/vendor/uitag/yolo-ui.pt
MACRO_LAYOUT_MODEL_FILENAME=yolo-ui.pt
OMNIPARSER_REPO_DIR=batch_mode/vendor/OmniParser
OMNIPARSER_WEIGHTS_DIR=batch_mode/vendor/OmniParser/weights

# Visual parsing.
BATCH_SAMPLE_FPS=0.5
DEMO_INTERVAL_SEC=1.0
SLIDE_INTERVAL_SEC=3.0
CODE_INTERVAL_SEC=2.0
OMNIPARSER_BBOX_THRESHOLD=0.05
OMNIPARSER_IOU_THRESHOLD=0.10
OMNIPARSER_IMGSZ=640
MACRO_LAYOUT_CONF=0.20
MACRO_LAYOUT_IOU=0.45

# Report writer. Use mock for smoke tests; switch to gemini, hf-local, or openrouter for production.
BATCH_LLM_BACKEND=mock
BATCH_LLM_MODEL=unsloth/Mistral-Small-24B-Instruct-2501-unsloth-bnb-4bit
BATCH_LLM_BASE_URL=
BATCH_LLM_API_KEY=
BATCH_LLM_MOCK_ENABLED=1
BATCH_LLM_TIMEOUT_SEC=180
BATCH_LLM_USE_PREWRITTEN=1
BATCH_LLM_SECTION_WORKERS=1
BATCH_LLM_MAX_PROMPT_CHARS=60000
BATCH_LLM_MAX_INPUT_TOKENS=24576
BATCH_LLM_MAX_NEW_TOKENS=3072
BATCH_QWEN_MODEL_NAME=Qwen/Qwen3-30B-A3B-FP8

# Embeddings and topic grouping.
BATCH_EMBEDDING_MODEL=BAAI/bge-m3
BATCH_EMBEDDING_DEVICE=cpu
BATCH_EMBEDDING_SIMILARITY_THRESHOLD=0.63
BATCH_TOPIC_SIMILARITY_THRESHOLD=0.69
BATCH_SEGMENT_MIN_SEC=10.0
BATCH_SEGMENT_MAX_SEC=30.0
BATCH_SEGMENT_TARGET_SEC=18.0

# Output locations.
BATCH_OUTPUT_DIR=batch_mode/outputs
BATCH_TEMP_DIR=batch_mode/tmp
BATCH_DOWNLOAD_TIMEOUT_SEC=600

# Optional Slurm / SSH cluster submission.
BATCH_CLUSTER_HOST=
BATCH_CLUSTER_USER=
BATCH_CLUSTER_PASSWORD=
BATCH_CLUSTER_ACCOUNT=
BATCH_CLUSTER_CONDA_ENV=torch_clean
BATCH_CLUSTER_PARTITION=short
BATCH_CLUSTER_GRES=gpu:3g.40gb:1
BATCH_CLUSTER_TIME_LIMIT=02:00:00
BATCH_CLUSTER_MEMORY=64G
BATCH_CLUSTER_CPUS_PER_TASK=8
BATCH_CLUSTER_PROJECT_DIR=/path/to/Meet-Analyzer
BATCH_CLUSTER_LOG_DIR=/path/to/Meet-Analyzer/batch_mode/myproject/logs
